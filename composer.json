{
  "name": "philgabriel/url-rewrite-snippets",
  "description": "Modular PHP snippets for generating clean, readable URL slugs – supporting German umlauts, accents, special characters and more.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Philipp Gabriel"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "files": [
      "snippets/php/replace_german_umlauts.php",
      "snippets/php/normalize_accents.php",
      "snippets/php/remove_special_chars.php",
      "snippets/php/collapse_dashes.php",
      "snippets/php/append_short_hash.php",
      "snippets/php/create_readable_slug.php"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/php/"
    ]
  },
  "scripts": {
    "test": "phpunit tests/php/SlugTest.php"
  },
  "config": {
    "optimize-autoloader": true
  }
}
