{
  "name": "url-rewrite-snippets",
  "version": "1.0.0",
  "description": "Modular snippets for generating clean, readable URL slugs – supporting German umlauts, accents, special characters and more.",
  "keywords": [
    "slug",
    "url",
    "rewrite",
    "umlaut",
    "seo",
    "permalink"
  ],
  "license": "MIT",
  "author": "Philipp Gabriel",
  "type": "module",
  "scripts": {
    "test": "npm run test:js && npm run test:ts",
    "test:js": "node --experimental-vm-modules node_modules/.bin/jest tests/javascript --testPathPattern=\"tests/javascript\"",
    "test:ts": "node --experimental-vm-modules node_modules/.bin/jest tests/typescript --testPathPattern=\"tests/typescript\"",
    "lint": "eslint snippets/ examples/ tests/ --ext .js,.ts",
    "build": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "extensionsToTreatAsEsm": [".ts"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "useESM": true, "diagnostics": { "ignoreCodes": ["TS151002"] } }]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.+)\\.js$": "$1"
    },
    "testEnvironment": "node"
  }
}
